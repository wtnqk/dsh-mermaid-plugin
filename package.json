{
  "name": "dsh-mermaid-plugin",
  "version": "0.1.0",
  "description": "Mermaid previews for DeepSeek Harness Web",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "mermaid"
  ],
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "check": "oxlint . && oxfmt --check .",
    "fmt": "oxfmt .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "pack:check": "bun run build && bunx npm pack --dry-run"
  },
  "dependencies": {
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "^0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-alpha.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.69.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-primitives": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  }
}
